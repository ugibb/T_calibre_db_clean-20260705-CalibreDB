  "sql": {
    "book_files_query": "SELECT books.id AS book_id, books.title AS title, books.path AS book_path, data.id AS data_id, data.format AS format, data.name AS file_basename, data.uncompressed_size AS bytes FROM books JOIN data ON data.book = books.id ORDER BY books.id, data.id"
  },
  "auto_delete_outputs": [
